# ============================================================
# J.A.R.V.I.S. SaaS — Variables de Entorno
# ============================================================
# Copiar a .env y completar con valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# === Base de Datos (Supabase Pooler o PostgreSQL local) ===
DATABASE_URL=postgresql://jarvis:jarvis_dev_2024@localhost:5432/jarvis_db

# === OpenAI (Whisper STT + GPT-4) ===
OPENAI_API_KEY=sk-...

# === ElevenLabs (TTS) ===
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Seguridad JWT ===
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA_ALEATORIA_DE_64_CARACTERES

# development | staging | production. En producción se rechaza una JWT vacía
# y CORS no puede usar comodines.
APP_ENV=development

# URL pública del frontend autorizada por CORS. En producción usar la URL real
# de Vercel, por ejemplo https://jarvis.skale.cl.

# Clave Fernet para cifrar secretos almacenados en la base de datos (Telegram,
# IoT y proveedores IA). Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=CAMBIAR_POR_UNA_CLAVE_FERNET_VALIDA

# === MercadoPago ===
MP_WEBHOOK_SECRET=...
MP_ACCESS_TOKEN=APP_USR-...
MP_BACK_URL=https://tu-dominio.cl/billing/return

# === CORS (orígenes permitidos, separados por coma) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# === Docker — solo para desarrollo local ===
POSTGRES_PASSWORD=jarvis_dev_2024
