# ============================================================
# J.A.R.V.I.S. SaaS — Variables de Entorno
# ============================================================
# Copiar a .env y completar con valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# === Base de Datos (Supabase Pooler o PostgreSQL local) ===
DATABASE_URL=postgresql://jarvis:jarvis_dev_2024@localhost:5432/jarvis_db

# === Biblioteca documental privada (Supabase Storage) ===
# Bucket privado creado previamente: knowledge-originals. Si no se configuran,
# la indexación funciona pero no se conserva el binario original fuera de la BD.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_KNOWLEDGE_BUCKET=knowledge-originals
# Intervalo de consulta del servicio knowledge-worker.
KNOWLEDGE_WORKER_POLL_SECONDS=2

# === Alertas operativas (opcionales) ===
# Webhook compatible con Slack/Teams/Discord, o bot administrativo de Telegram.
# Nunca usar un bot vinculado a un tenant de cliente.
OPERATIONS_ALERT_WEBHOOK_URL=
ADMIN_ALERT_TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_TELEGRAM_CHAT_ID=
OPERATIONS_ALERT_COOLDOWN_MINUTES=30

# Retención de telemetría operacional (no borra documentos, chats ni cuentas).
RAG_AUDIT_RETENTION_DAYS=90
TELEGRAM_WEBHOOK_RETENTION_DAYS=30

# === OpenAI (Whisper STT + GPT-4) ===
OPENAI_API_KEY=sk-...

# === ElevenLabs (TTS) ===
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Seguridad JWT ===
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA_ALEATORIA_DE_64_CARACTERES

# development | staging | production. En producción se rechaza una JWT vacía
# y CORS no puede usar comodines.
APP_ENV=development

# === Prueba gratuita ===
# Se aplican por organización y se validan antes de cada llamada a IA.
TRIAL_DAYS=7
TRIAL_DAILY_TOKEN_LIMIT=5000

# URL pública del frontend autorizada por CORS. En producción usar la URL real
# de Vercel, por ejemplo https://jarvis.skale.cl.

# Clave Fernet para cifrar secretos almacenados en la base de datos (Telegram,
# IoT y proveedores IA). Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=CAMBIAR_POR_UNA_CLAVE_FERNET_VALIDA

# === MercadoPago ===
MP_WEBHOOK_SECRET=...
MP_ACCESS_TOKEN=APP_USR-...
MP_BACK_URL=https://tu-dominio.cl/billing/return

# === Meta / WhatsApp Business Platform ===
META_APP_ID=...
META_APP_SECRET=...
META_WEBHOOK_VERIFY_TOKEN=CAMBIAR_POR_SECRETO_ALEATORIO
META_OAUTH_REDIRECT_URL=https://tu-api-publica.cl/v1/marketing/connections/meta/callback

# === CORS (orígenes permitidos, separados por coma) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# === Docker — solo para desarrollo local ===
POSTGRES_PASSWORD=jarvis_dev_2024
